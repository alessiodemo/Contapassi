<?xml version="1.0" encoding="utf-8"?>
<!--
  Sfondo del widget. Il raggio arriva da @dimen/widget_corner_radius, che su
  Android 12+ (values-v31) diventa il raggio di sistema: cosi' la nostra forma
  combacia con la sagoma che il launcher ritaglia, invece di lasciare gli angoli
  quadrati dentro un ritaglio tondo.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_background" />
    <corners android:radius="@dimen/widget_corner_radius" />
</shape>
