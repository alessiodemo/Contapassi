<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_m"
    android:layout_marginVertical="@dimen/space_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/card_content_padding">

        <!-- data -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/giornoOb"
                style="@style/PassiText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/giorno" />

            <TextView
                android:id="@+id/meseOb"
                style="@style/PassiText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/meseOb"
                android:textAllCaps="true" />
        </LinearLayout>

        <!-- passi / obiettivo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="@dimen/space_xs"
                android:src="@drawable/walk_outline" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/passiOb"
                    style="@style/PassiText.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/passiOggi" />

                <TextView
                    android:id="@+id/obiettivoOb"
                    style="@style/PassiText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/suPassiOb" />
            </LinearLayout>
        </LinearLayout>

        <!-- km / kcal -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/kmOb"
                style="@style/PassiText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/route_outline"
                android:drawablePadding="@dimen/space_xs"
                android:paddingBottom="@dimen/space_xs"
                android:text="@string/kmEtichetta" />

            <TextView
                android:id="@+id/kcalOb"
                style="@style/PassiText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/fire_outline"
                android:drawablePadding="@dimen/space_xs"
                android:text="@string/kcalEtichetta" />
        </LinearLayout>

        <!-- esito obiettivo -->
        <ImageView
            android:id="@+id/checkOb"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/check_circle" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
