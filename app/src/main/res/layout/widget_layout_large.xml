<?xml version="1.0" encoding="utf-8"?>
<!--
  Il widget e' lo spazio piu' stretto in assoluto (puo' scendere a 130dp di larghezza
  divisi in tre colonne). Qui NON si puo' usare app:autoSize* di AppCompat, perche' il
  launcher inflaziona con un LayoutInflater normale: si usa android:autoSizeTextType,
  che e' la versione di piattaforma, disponibile da API 26 (il nostro minSdk).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <!-- intestazione -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_icon_circle"
            android:contentDescription="@string/passi"
            android:padding="9dp"
            android:src="@drawable/walk_black"
            android:tint="@color/widget_on_accent_container"
            tools:ignore="UseAppTint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="@dimen/text_size_display"
                android:autoSizeMinTextSize="@dimen/text_size_subtitle"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:maxLines="1"
                android:text="@string/passiOggi"
                android:textColor="@color/widget_accent"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/passi"
                android:textColor="@color/widget_on_background_variant"
                android:textSize="@dimen/text_size_caption" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressPassi"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginVertical="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />

    <!-- calorie e meteo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="@dimen/text_size_subtitle"
            android:autoSizeMinTextSize="@dimen/text_size_autosize_min"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:drawableLeft="@drawable/fire"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/calorie"
            android:textColor="@color/widget_on_background" />

        <TextView
            android:id="@+id/textView10"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="@dimen/text_size_subtitle"
            android:autoSizeMinTextSize="@dimen/text_size_autosize_min"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:drawableLeft="@drawable/sunny"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/meteoSole"
            android:textColor="@color/widget_on_background" />

    </LinearLayout>

    <!-- separatore come LinearLayout e non come View: RemoteViews accetta solo una
         lista chiusa di widget (FrameLayout, LinearLayout, TextView, ImageView...)
         e la View "nuda" non ne fa parte, verrebbe rifiutata all'inflate -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:alpha="0.35"
        android:background="@color/widget_on_background_variant" />

    <!-- riepilogo settimana / mese / obiettivi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="@dimen/text_size_caption"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/settimana"
                android:textColor="@color/widget_on_background_variant" />

            <TextView
                android:id="@+id/mediaPassiSettimana"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="@dimen/text_size_subtitle"
                android:autoSizeMinTextSize="@dimen/text_size_autosize_min"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/passiOggi"
                android:textColor="@color/widget_on_background"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mediaKmSettimana"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="@dimen/text_size_caption"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/kmEtichetta"
                android:textColor="@color/widget_on_background_variant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="@dimen/text_size_caption"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/mese"
                android:textColor="@color/widget_on_background_variant" />

            <TextView
                android:id="@+id/mediaPassiMese"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="@dimen/text_size_subtitle"
                android:autoSizeMinTextSize="@dimen/text_size_autosize_min"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/passiOggi"
                android:textColor="@color/widget_on_background"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mediaKmMese"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="@dimen/text_size_caption"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/kmEtichetta"
                android:textColor="@color/widget_on_background_variant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="@dimen/text_size_caption"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/obiettivi"
                android:textColor="@color/widget_on_background_variant" />

            <TextView
                android:id="@+id/obiettiviRaggiunti"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="@dimen/text_size_subtitle"
                android:autoSizeMinTextSize="@dimen/text_size_autosize_min"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/passiOggi"
                android:textColor="@color/widget_accent"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/obiettiviTotali"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="@dimen/text_size_caption"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/obiettiviTot"
                android:textColor="@color/widget_on_background_variant" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
