<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/light_black">

    <TextView
        android:id="@+id/textView8"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:drawableLeft="@drawable/walk_black"
        android:drawablePadding="2sp"
        android:gravity="center"
        android:text="@string/passi"
        android:textSize="24sp"
        android:textStyle="bold|italic"
        android:typeface="normal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableLeft="@drawable/fire"
            android:text="@string/calorie"
            android:textSize="20sp"
            android:gravity="center"
            android:layout_marginRight="-110dp" />

        <TextView
            android:id="@+id/textView10"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="110dp"
            android:drawableLeft="@drawable/sunny"
            android:text="@string/meteoSole"
            android:gravity="center"
            android:textSize="20sp" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textSize="20sp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settimana"/>
            <TextView
                android:id="@+id/mediaPassiSettimana"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/passiOggi"
                android:textSize="20sp"
                android:textColor="@color/black" />
            <TextView
                android:id="@+id/mediaKmSettimana"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/km"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mese"/>
            <TextView
                android:id="@+id/mediaPassiMese"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/passiOggi"
                android:textSize="20sp"
                android:textColor="@color/black" />
            <TextView
                android:id="@+id/mediaKmMese"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/km"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/obiettivi"/>
            <TextView
                android:id="@+id/obiettiviRaggiunti"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/passiOggi"
                android:textSize="20sp"
                android:textColor="@color/black" />
            <TextView
                android:id="@+id/obiettiviTotali"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/obiettiviTot"/>
        </LinearLayout>
    </LinearLayout>


</LinearLayout>