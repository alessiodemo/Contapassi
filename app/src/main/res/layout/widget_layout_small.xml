<?xml version="1.0" encoding="utf-8"?>
<!--
  NOTA sui widget: sono inflazionati dal LAUNCHER, non dalla nostra Activity.
  Un ?attr/colorSurface verrebbe risolto contro il tema del launcher, quindi qui
  servono @color/ espliciti. Seguono comunque chiaro/scuro (values-night) e i
  colori di sistema su Android 12+ (values-v31).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/appwidget_text"
        android:drawableLeft="@drawable/walk_black"
        android:drawablePadding="6dp"
        android:drawableTint="@color/widget_accent"
        android:gravity="center"
        android:text="@string/passi"
        android:textAlignment="center"
        android:textColor="@color/widget_on_background"
        android:textSize="@dimen/text_size_widget_headline"
        android:textStyle="bold" />
</LinearLayout>
