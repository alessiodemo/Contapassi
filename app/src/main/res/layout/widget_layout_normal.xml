<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <TextView
        android:id="@+id/textView5"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="@dimen/text_size_widget_headline"
        android:autoSizeMinTextSize="@dimen/text_size_body"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:drawableLeft="@drawable/walk_black"
        android:drawablePadding="6dp"
        android:drawableTint="@color/widget_accent"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/passi"
        android:textColor="@color/widget_on_background"
        android:textStyle="bold" />

    <!-- due colonne di uguale peso: prima erano allineate con marginRight="-110dp"
         su una e marginStart="110dp" sull'altra, due margini che si annullavano a
         una sola larghezza di schermo e sballavano su tutte le altre -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="@dimen/text_size_subtitle"
            android:autoSizeMinTextSize="@dimen/text_size_autosize_min"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:drawableLeft="@drawable/fire"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/calorie"
            android:textColor="@color/widget_on_background_variant" />

        <TextView
            android:id="@+id/textView7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="@dimen/text_size_subtitle"
            android:autoSizeMinTextSize="@dimen/text_size_autosize_min"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:drawableLeft="@drawable/sunny"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/meteoSole"
            android:textColor="@color/widget_on_background_variant" />

    </LinearLayout>

</LinearLayout>
