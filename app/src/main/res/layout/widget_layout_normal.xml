<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <!-- intestazione: icona in pastiglia + numero grande + etichetta piccola.
         E' la gerarchia che mancava: prima tutto stava su una riga sola,
         quindi niente aveva piu' peso di altro. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_icon_circle"
            android:contentDescription="@string/passi"
            android:padding="8dp"
            android:src="@drawable/walk_black"
            android:tint="@color/widget_on_accent_container"
            tools:ignore="UseAppTint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="@dimen/text_size_widget_headline"
                android:autoSizeMinTextSize="@dimen/text_size_body"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:maxLines="1"
                android:text="@string/passiOggi"
                android:textColor="@color/widget_accent"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/passi"
                android:textColor="@color/widget_on_background_variant"
                android:textSize="@dimen/text_size_caption" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressPassi"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginVertical="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="@dimen/text_size_subtitle"
            android:autoSizeMinTextSize="@dimen/text_size_autosize_min"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:drawableLeft="@drawable/fire"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/calorie"
            android:textColor="@color/widget_on_background" />

        <TextView
            android:id="@+id/textView7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="@dimen/text_size_subtitle"
            android:autoSizeMinTextSize="@dimen/text_size_autosize_min"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:drawableLeft="@drawable/sunny"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/meteoSole"
            android:textColor="@color/widget_on_background" />

    </LinearLayout>

</LinearLayout>
