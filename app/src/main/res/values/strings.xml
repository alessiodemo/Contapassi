    <!--
      FORMATI CON UNITA' DI MISURA.
      Sono l'unico punto dell'app in cui compaiono "km", "kcal" e "°C": prima le stesse
      unita' erano concatenate a mano in quattro classi diverse, con cinque grafie
      differenti ("km", "Km", " km", "kcal", "Kcal").

      I simboli SI vogliono la k minuscola (la K maiuscola e' il Kelvin) e uno spazio
      tra valore e unita'.

      %1$s / %1$d sono segnaposto POSIZIONALI: il numero dice quale argomento inserire
      e la lettera di che tipo e'. Il tipo sbagliato non e' un errore di compilazione ma
      un crash a runtime, quindi s = stringa gia' formattata, d = intero.
    -->
    <string name="formato_km">%1$s km</string>
    <string name="formato_kcal">%1$s kcal</string>
    <string name="formato_gradi">%1$d °C</string>
    <string name="formato_obiettivo">/%1$d</string>
    <string name="formato_su_obiettivo">su %1$d</string>

